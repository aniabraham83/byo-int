# Example environment variables for byoint
# Copy this file to .env and replace every CHANGE_ME value before starting:
#   cp .env.example .env
# These names match docker-compose.yml.

# --- MongoDB root credentials (used by the mongo container and the app) ---
MONGO_INITDB_ROOT_USERNAME=CHANGE_ME_MONGO_USER
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD

# --- Required secrets ---
# Signs Flask sessions
FLASK_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Encrypts datapull secrets (32+ characters recommended)
DATAPULL_SECRET_MASTER_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Seeds the admin user when the users collection is empty
BYOINT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Shared secret between the app and the snippet_runner container (16+ characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SNIPPET_RUNNER_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# --- Mongo bootstrap ---
# none | init | reset   (use init on first start to load seed data)
MONGO_INIT_WORKFLOW=init
# Seed file (absolute path or repo-relative)
MONGO_INIT_FILE=mongo_init.json
# Set to true to rerun init after it has already completed once
# MONGO_INIT_FORCE_REAPPLY=false

# --- Optional TLS for the web container ---
# Filenames inside ./certs (mounted read-only). If not found, a bundled self-signed cert is used.
# TLS_CERT_FILE=tls.crt
# TLS_KEY_FILE=tls.key
