# Isolated container that runs custom snippets for BYO-INT (see byoint_core/snippet_runner.py).
# It contains only the snippet runner and the packages snippets may import: no app code,
# no database drivers, and (via docker-compose) no app secrets and no route to MongoDB or Redis.
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements-snippet-runner.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin snippet

WORKDIR /runner
COPY byoint_core/snippet_runner.py byoint_core/snippet_sandbox.py byoint_core/snippet_child.py ./

USER 10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).read()"
CMD ["python", "snippet_runner.py"]
