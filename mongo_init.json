          "_id": "cap_feodo_tracker",
          "product": "Feodo Tracker IP blocklist",
          "vendor": "abuse.ch",
          "category": "Threat feed",
          "method": "custom_snippet",
          "template_name": null,
          "capability": "Botnet C2 IPs; snippet skips # comment lines",
          "data_types": [
            "ipv4"
          ],
          "tested_version": null,
          "status": "partial",
          "tested_by": null,
          "notes": "Snippet dry-run against the live feed returned valid ipv4 values (5 IPs) under the snippet sandbox restrictions; not yet run as a workflow. Create a Custom template with this snippet (optional ufield arg: feed_url).",
          "snippet_example": "import requests\n\ntarget_url = template_args.get('feed_url') or 'https://feodotracker.abuse.ch/downloads/ipblocklist.txt'\nresponse = requests.get(target_url, timeout=30)\nresponse.raise_for_status()\n\nresult_list = []\nfor line in response.text.splitlines():\n    value = line.strip()\n    if value and not value.startswith('#'):\n        result_list.append({'value': value, 'dtype': 'ipv4'})",
          "reference_url": "https://feodotracker.abuse.ch/blocklist/"
        },
        {
          "_id": "cap_otx",
          "product": "AlienVault OTX subscribed pulses",
          "vendor": "LevelBlue (AT&T Cybersecurity)",
          "category": "Threat intel platform",
          "method": "custom_snippet",
          "template_name": null,
          "capability": "Indicators from subscribed pulses; needs the X-OTX-API-KEY header, which api_with_key cannot send",
          "data_types": [
            "ipv4",
            "domain",
            "hostname",
            "url",
            "sha256"
          ],
          "tested_version": null,
          "status": "untested",
          "tested_by": null,
          "notes": "Requires a free OTX API key stored in Secrets (ufield arg: otx_api_key_secret_ref).",
          "snippet_example": "import requests\n\n# ufield_args: otx_api_key_secret_ref (resolved at runtime to `otx_api_key`)\nheaders = {'X-OTX-API-KEY': otx_api_key}\ntype_map = {'IPv4': 'ipv4', 'domain': 'domain', 'hostname': 'hostname', 'URL': 'url', 'FileHash-SHA256': 'sha256'}\nnext_url = 'https://otx.alienvault.com/api/v1/pulses/subscribed?limit=50'\n\nresult_list = []\npages = 0\nwhile next_url and pages < 20:\n    response = requests.get(next_url, headers=headers, timeout=30)\n    response.raise_for_status()\n    body = response.json()\n    for pulse in body.get('results', []):\n        for ioc in pulse.get('indicators', []):\n            dtype = type_map.get(ioc.get('type'))\n            if dtype:\n                result_list.append({'value': ioc.get('indicator'), 'dtype': dtype})\n    next_url = body.get('next')\n    pages += 1",
          "reference_url": "https://otx.alienvault.com/api"
        },
        {
          "_id": "cap_threatfox",
          "product": "ThreatFox IOCs",
          "vendor": "abuse.ch",
          "category": "Threat intel platform",
          "method": "custom_snippet",
          "template_name": null,
          "capability": "Last 24h IOCs via POST JSON API; ip:port values are split to the IP",
          "data_types": [
            "ipv4",
            "domain",
            "url",
            "sha256"
          ],
          "tested_version": null,
          "status": "untested",
          "tested_by": null,
          "notes": "Requires an abuse.ch Auth-Key stored in Secrets (ufield arg: threatfox_auth_key_secret_ref).",
          "snippet_example": "import requests\n\n# ufield_args: threatfox_auth_key_secret_ref (resolved at runtime to `threatfox_auth_key`)\nresponse = requests.post(\n    'https://threatfox-api.abuse.ch/api/v1/',\n    json={'query': 'get_iocs', 'days': 1},\n    headers={'Auth-Key': threatfox_auth_key},\n    timeout=30,\n)\nresponse.raise_for_status()\ndata = response.json().get('data')\nif not isinstance(data, list):\n    data = []\n\nresult_list = []\nfor ioc in data:\n    value = str(ioc.get('ioc') or '')\n    ioc_type = ioc.get('ioc_type')\n    if ioc_type == 'ip:port':\n        result_list.append({'value': value.split(':')[0], 'dtype': 'ipv4'})\n    elif ioc_type == 'domain':\n        result_list.append({'value': value, 'dtype': 'domain'})\n    elif ioc_type == 'url':\n        result_list.append({'value': value, 'dtype': 'url'})\n    elif ioc_type == 'sha256_hash':\n        result_list.append({'value': value, 'dtype': 'sha256'})",
          "reference_url": "https://threatfox.abuse.ch/api/"
        },
