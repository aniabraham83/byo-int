          "description": "Built-in Active Directory / LDAP search datapull",
          "function_mapping": "ldap_search_v1",
          "info": "Built-in template 'basic_ldap_search' binds to an Active Directory / LDAP server, runs a paged search, and extracts indicators from the requested attributes into the indicator store. Binary attributes (objectSid, objectGUID) are skipped.\nExample (AD computers -> hostname data type):\nLdap Server: ldaps://dc01.corp.local:636\nBind Dn: CN=svc-byoint,OU=Service Accounts,DC=corp,DC=local\nBind Password Secret Ref: service account password stored in Secrets\nBase Dn: DC=corp,DC=local\nSearch Filter: (&(objectClass=computer)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))\nAttributes: dNSHostName\nUse ldaps:// (636) or Start TLS on ldap:// (389); plain LDAP sends the bind password in cleartext.",
          "template_name": "basic_ldap_search",
          "template_type": "builtin",
          "ufield_args": [
            {
              "field_name": "ldap_server",
              "mandatory": true,
              "description": "ldaps://dc01.corp.local:636"
            },
            {
              "field_name": "bind_dn",
              "mandatory": true,
              "description": "CN=svc-byoint,OU=Service Accounts,DC=corp,DC=local or svc-byoint@corp.local"
            },
            {
              "field_name": "bind_password_secret_ref",
              "mandatory": true
            },
            {
              "field_name": "base_dn",
              "mandatory": true,
              "description": "DC=corp,DC=local"
            },
            {
              "field_name": "search_filter",
              "mandatory": true,
              "description": "(objectClass=computer)"
            },
            {
              "field_name": "attributes",
              "mandatory": true,
              "description": "Comma-separated, e.g. dNSHostName,cn"
            },
            {
              "field_name": "search_scope",
              "mandatory": false,
              "description": "SUBTREE (default), LEVEL or BASE"
            },
            {
              "field_name": "start_tls",
              "mandatory": false,
              "description": "Upgrade ldap:// connections with StartTLS (ignored for ldaps://)"
            },
            {
              "field_name": "verify_ssl",
              "mandatory": true
            },
            {
              "field_name": "page_size",
              "mandatory": false,
              "description": "1000 (AD default MaxPageSize)"
            },
            {
              "field_name": "timeout",
              "mandatory": false
            }
          ]
        }
