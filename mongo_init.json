          "_id": "697e94810c9d00700a4ccb3f",
          "name": "ipv4",
          "regex_extract_pattern": "^(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$",
          "type": "builtin"
        },
        {
          "_id": "697eb0fe0c9d00700a4ccb40",
          "name": "domain",
          "regex_extract_pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$",
          "type": "builtin"
        },
        {
          "_id": "6a038f2ebca920afb569f12e",
          "name": "ipv6",
          "regex_extract_pattern": "^((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,3})(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,2})(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:)|(?:[0-9A-Fa-f]{1,4}:){6}(?:\\d{1,3}\\.){3}\\d{1,3}|(?:[0-9A-Fa-f]{1,4}:){1,5}:(?:\\d{1,3}\\.){3}\\d{1,3})$",
          "type": "builtin"
        },
        {
          "_id": "6a0390f3bca920afb569f136",
          "name": "url",
          "regex_extract_pattern": "^(https?:\\/\\/)(localhost|(([a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,})|(\\d{1,3}(\\.\\d{1,3}){3})|(\\[[0-9A-Fa-f:]+\\]))(:\\d{1,5})?(\\/[^\\s]*)?$",
          "type": "builtin"
        },
        {
          "_id": "6a039182bca920afb569f147",
          "name": "sha256",
          "regex_extract_pattern": "^[a-fA-F0-9]{64}$",
          "type": "builtin"
        },
